{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node10",
		"ignoreDeprecations": "6.0",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"declaration": true,
		"skipLibCheck": true,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"incremental": true,
		// Keep the incremental build cache out of `outDir`: `files: ["dist"]` in package.json
		// means everything under dist/ is published, and dist/tsconfig.tsbuildinfo shipped in 0.1.9.
		"tsBuildInfoFile": "./.tsbuildinfo",
		"sourceMap": true,
		"outDir": "./dist"
	},
	"include": ["nodes/**/*", "credentials/**/*", "nodes/**/*.json", "package.json"]
}
